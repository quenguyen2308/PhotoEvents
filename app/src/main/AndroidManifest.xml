<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Photo Events"
        android:theme="@style/Theme.PhotoEvents"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- Activity Alias cho Theme 1: Sakura Blossom (Mặc định) -->
        <activity-alias
            android:name=".MainActivitySakura"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sakura"
            android:roundIcon="@mipmap/ic_launcher_sakura_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Activity Alias cho Theme 2: Memory Chest 3D -->
        <activity-alias
            android:name=".MainActivityMemoryChest"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_memory_chest"
            android:roundIcon="@mipmap/ic_launcher_memory_chest_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Activity Alias cho Theme 3: Memory Journal 3D -->
        <activity-alias
            android:name=".MainActivityMemoryJournal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_memory_journal"
            android:roundIcon="@mipmap/ic_launcher_memory_journal_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".AddEventActivity"
            android:exported="false" />

        <activity
            android:name=".EventDetailActivity"
            android:exported="false" />

        <activity
            android:name=".CategoryManagementActivity"
            android:exported="true" />

    </application>
</manifest>
