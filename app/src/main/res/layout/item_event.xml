<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Khung Bento Mosaic đa ảnh nghệ thuật -->
        <FrameLayout
            android:id="@+id/bentoContainer"
            android:layout_width="match_parent"
            android:layout_height="215dp"
            android:background="?attr/colorSurfaceVariant">

            <!-- Lưới Bento Mosaic -->
            <LinearLayout
                android:id="@+id/layoutMosaic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Cột ảnh chính (Hero / Portrait) -->
                <FrameLayout
                    android:id="@+id/frameMainImage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="60">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.PhotoEvents.BentoMain" />

                </FrameLayout>

                <!-- Cột ảnh phụ bên phải (chỉ hiện khi có >= 2 ảnh) -->
                <LinearLayout
                    android:id="@+id/layoutSubImages"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="40"
                    android:layout_marginStart="3dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Ảnh phụ 1 (trên) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgSub1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.PhotoEvents.BentoSubTop" />

                    <!-- Ảnh phụ 2 (dưới) - chỉ hiện khi có >= 3 ảnh -->
                    <FrameLayout
                        android:id="@+id/frameSub2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="3dp"
                        android:visibility="gone">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgSub2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <!-- Overlay lớp mờ +N ảnh khi tổng số ảnh > 3 -->
                        <TextView
                            android:id="@+id/txtMoreImagesOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#80000000"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="+5" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Checkbox khi vào chế độ chọn nhiều -->
            <FrameLayout
                android:id="@+id/checkboxContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp">

                <CheckBox
                    android:id="@+id/checkboxSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/colorPrimary"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Huy hiệu số lượng ảnh ở góc dưới -->
            <TextView
                android:id="@+id/txtImageCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_count_badge"
                android:drawableStart="@drawable/ic_photo_library"
                android:drawablePadding="5dp"
                app:drawableTint="?attr/colorPrimary"
                android:gravity="center_vertical"
                android:textColor="@color/sakura_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="8 ảnh" />

        </FrameLayout>

        <!-- Thân thẻ: Tiêu đề, ghi chú và nút mở rộng ảnh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="17sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Chuyến đi Đà Lạt" />

                <ImageButton
                    android:id="@+id/btnExpand"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="Xổ ra / thu lại ảnh"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Ngày diễn ra sự kiện - bên dưới tiêu đề -->
            <TextView
                android:id="@+id/txtEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_floating_date_badge"
                android:drawableStart="@drawable/ic_calendar"
                android:drawablePadding="6dp"
                app:drawableTint="?attr/colorPrimary"
                android:gravity="center_vertical"
                android:textColor="@color/badge_date_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                tools:text="30/09/2026" />

            <TextView
                android:id="@+id/txtNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Kỷ niệm tuyệt vời cùng gia đình tại đồi chè Cầu Đất." />

        </LinearLayout>

        <!-- Dải xem nhanh tất cả ảnh khi xổ ra -->
        <HorizontalScrollView
            android:id="@+id/scrollImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingBottom="14dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/imagesStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </HorizontalScrollView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
