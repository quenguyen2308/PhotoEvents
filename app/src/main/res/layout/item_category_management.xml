<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategoryManageItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/sakura_border_soft"
    app:cardBackgroundColor="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingVertical="12dp">

        <!-- Vòng tròn Emoji -->
        <FrameLayout
            android:id="@+id/frameManageIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_category_icon_circle"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/txtManageCategoryIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="20sp"
                tools:text="💖" />

        </FrameLayout>

        <!-- Thông tin Tên + Loại + Số sự kiện -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtManageCategoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/sakura_text_primary"
                tools:text="Kỷ niệm" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtManageCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="1.5dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/sakura_pink"
                    android:background="@drawable/bg_count_badge"
                    tools:text="Mặc định" />

                <TextView
                    android:id="@+id/txtManageEventCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/sakura_text_secondary"
                    tools:text="12 sự kiện" />

            </LinearLayout>

        </LinearLayout>

        <!-- Các nút thao tác -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Nút sửa -->
            <ImageButton
                android:id="@+id/btnManageEdit"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                app:tint="@color/colorPrimary"
                android:contentDescription="Sửa danh mục" />

            <!-- Nút xoá -->
            <ImageButton
                android:id="@+id/btnManageDelete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="#E11D48"
                android:contentDescription="Xoá danh mục" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
