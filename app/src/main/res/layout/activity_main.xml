<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Thanh tiêu đề chính -->
        <LinearLayout
            android:id="@+id/headerNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <!-- Bên trái: Logo + Tên App + Mô tả -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp">

                <!-- Sakura icon box -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_sakura_icon_box"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🌸"
                        android:textSize="20sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Photo Events"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/sakura_text_primary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Nút Tìm kiếm sự kiện -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSearch"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:minWidth="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:layout_marginEnd="8dp"
                app:backgroundTint="@color/surface"
                android:backgroundTint="@color/surface"
                app:strokeColor="@color/sakura_border_soft"
                app:strokeWidth="1.2dp"
                app:cornerRadius="100dp"
                app:elevation="1dp"
                app:rippleColor="#33FF6584"
                app:icon="@drawable/ic_search"
                app:iconSize="17dp"
                app:iconTint="@color/sakura_pink"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:contentDescription="Tìm kiếm sự kiện" />

            <!-- Nút Quản lý danh mục -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageCategories"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:minWidth="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:layout_marginEnd="8dp"
                app:backgroundTint="@color/surface"
                android:backgroundTint="@color/surface"
                app:strokeColor="@color/sakura_border_soft"
                app:strokeWidth="1.2dp"
                app:cornerRadius="100dp"
                app:elevation="1dp"
                app:rippleColor="#33FF6584"
                app:icon="@drawable/ic_category"
                app:iconSize="17dp"
                app:iconTint="@color/sakura_pink"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:contentDescription="Quản lý danh mục" />

            <!-- Bên phải: Nút sắp xếp dạng Sakura Pill Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSort"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="Mới nhất"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/sakura_text_primary"
                app:backgroundTint="@color/surface"
                android:backgroundTint="@color/surface"
                app:strokeColor="@color/sakura_border_soft"
                app:strokeWidth="1.2dp"
                app:cornerRadius="100dp"
                app:elevation="1dp"
                app:rippleColor="#33FF6584"
                app:icon="@drawable/ic_sort"
                app:iconSize="15dp"
                app:iconTint="@color/sakura_pink"
                app:iconPadding="6dp"
                app:iconGravity="textStart"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Thanh Tìm kiếm Mở rộng Sakura Search Bar -->
        <LinearLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_floating_date_badge"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Tìm kiếm" />

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Tìm kiếm sự kiện, kỷ niệm..."
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Xoá tìm kiếm" />

        </LinearLayout>

        <!-- Thanh chế độ chọn nhiều kiểu Sakura Blossom -->
        <LinearLayout
            android:id="@+id/headerSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_floating_date_badge"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCancelSelection"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Huỷ chọn" />

            <TextView
                android:id="@+id/txtSelectedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                tools:text="🌸 2 đã chọn" />

            <ImageButton
                android:id="@+id/btnSelectAll"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_select_all"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Chọn tất cả" />

            <ImageButton
                android:id="@+id/btnDeleteSelected"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Xoá các sự kiện đã chọn" />

        </LinearLayout>

        <!-- Danh sách Category Card View PIN cố định ở đầu trang -->
        <FrameLayout
            android:id="@+id/layoutCategoriesPinned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:orientation="horizontal"
                android:overScrollMode="never" />

        </FrameLayout>

        <!-- SwipeRefresh + RecyclerView -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="96dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/txtEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_floating_date_badge">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_photo_library"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Chưa có ảnh" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chưa có sự kiện nào"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txtEmptySubtitle"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bấm 'Tạo sự kiện' bên dưới để bắt đầu lưu giữ những kỷ niệm đáng nhớ."
            android:textAlignment="center"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:lineSpacingExtra="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyAction"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🌸 Tạo sự kiện mới"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:cornerRadius="100dp" />

    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/ic_add"
        app:tint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="4dp"
        android:contentDescription="Thêm sự kiện" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
